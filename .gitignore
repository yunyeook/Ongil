# ============================================
# 문서 및 임시 파일
# ============================================

# 문서 임시 파일
docs/*.pdf
docs/*.docx
docs/.~*

# 설계 파일 임시본
*.backup
*.autosave

# ============================================
# 의존성 및 패키지
# ============================================

# Node modules (만약 프론트 추가시)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Python (AI/ML 스크립트용)
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
ENV/

