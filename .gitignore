# ============================================
# Ongil Project Root .gitignore
# 백엔드(Spring Boot) + 안드로이드(모바일+워치) 통합
# ============================================

# ============================================
# 공통 (Common)
# ============================================

# OS 관련
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# 에디터/IDE 공통
*~
*.swp
*.swo
*.bak
*.tmp
*.temp

# 환경 변수 파일
.env
.env.local
.env.*.local
*.env

# 로그 파일
*.log
logs/
log/

# ============================================
# 백엔드 (Spring Boot / Gradle)
# ============================================

# Gradle
BE/.gradle/
BE/build/
BE/out/
BE/gradle-app.setting
BE/!gradle/wrapper/gradle-wrapper.jar
BE/!**/src/main/**/build/
BE/!**/src/test/**/build/

# IntelliJ IDEA
BE/.idea/
BE/*.iws
BE/*.iml
BE/*.ipr
BE/out/
BE/!**/src/main/**/out/
BE/!**/src/test/**/out/

# Eclipse
BE/.apt_generated
BE/.classpath
BE/.factorypath
BE/.project
BE/.settings
BE/.springBeans
BE/.sts4-cache
BE/bin/
BE/!**/src/main/**/bin/
BE/!**/src/test/**/bin/

# VS Code
BE/.vscode/

# Spring Boot
BE/application-secret.yml
BE/application-local.yml

# 데이터베이스
BE/*.db
BE/*.sqlite
BE/*.sqlite3

# Firebase 인증 파일
BE/src/main/resources/firebase-credentials.json
BE/firebase-credentials.json

# QueryDSL 생성 파일
BE/src/main/generated/

